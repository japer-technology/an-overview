ric\": {\n      \"summary\": \"An in-progress repository focused on fabric-style publishing and GitHub-native delivery.\",\n      \"status\": \"experimental\",\n      \"tags\": [\"fabric\"]\n    },\n    \"github-openclaw-intelligence\": {\n      \"summary\": \"A GitHub-native intelligence variant built around OpenClaw-oriented workflows.\",\n      \"status\": \"active\",\n      \"tags\": [\"openclaw\", \"automation\"]\n    },\n    \"github-agenticana-intelligence\": {\n      \"summary\": \"A GitHub-native intelligence variant oriented around Agenticana workflows and experimentation.\",\n      \"status\": \"active\",\n      \"tags\": [\"agenticana\", \"automation\"]\n    }\n  }\n}\n"}],"isError":false,"timestamp":1773521161479}}
