# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Repomix — Pack Repository → Artifact (Custom)                               ║
# ║                                                                              ║
# ║  Packs the repository using Repomix with fully customisable options          ║
# ║  supplied at run time via workflow_dispatch inputs, then uploads the         ║
# ║  result as a downloadable workflow artifact.                                 ║
# ║                                                                              ║
# ║  INPUTS (all optional — defaults shown):                                     ║
# ║    directories   Space-separated list of directories to pack  (default: .)   ║
# ║    style         Output format: xml | markdown | json | plain (default: xml) ║
# ║    output        File name of the packed output (repomix-output.{ext})       ║
# ║    include       Comma-separated glob patterns to include     (default: "")  ║
# ║    ignore        Comma-separated glob patterns to exclude     (default: "")  ║
# ║    compress      Enable smart compression                     (default: true)║
# ║                                                                              ║
# ║  USAGE:  Actions → repomix-pack-custom → Run workflow → fill in options      ║
# ║                                                                              ║
# ║  This file is self-contained — copy it into any repository and it will       ║
# ║  work without modification.                                                  ║
# ║                                                                              ║
# ║  See: https://repomix.com/guide/github-actions                               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

name: repomix-pack-custom

# ──────────────────────────────────────────────────────────────────────────────
# TRIGGERS — manual only, with user-supplied options
# ──────────────────────────────────────────────────────────────────────────────
on:
  workflow_dispatch:
    inputs:
      directories:
        description: "Directories to pack (space-separated, e.g. 'src tests')"
        required: false
        default: "."
      style:
        description: "Output style"
        required: false
        default: "xml"
        type: choice
        options:
          - xml
          - markdown
          - json
          - plain
      include:
        description: "Glob patterns to include (comma-separated, e.g. '**/*.ts,**/*.md')"
        required: false
        default: ""
      ignore:
        description: "Glob patterns to ignore (comma-separated, e.g. '**/*.test.ts')"
        required: false
        default: ""
      compress:
        description: "Enable smart compression (removes whitespace / noise)"
        required: false
        default: "true"
        type: choice
        options:
          - "true"
          - "false"

# ──────────────────────────────────────────────────────────────────────────────
# PERMISSIONS — read-only; we only produce an artifact, no writes needed
# ──────────────────────────────────────────────────────────────────────────────
permissions:
  contents: read

# ══════════════════════════════════════════════════════════════════════════════
# JOBS
# ══════════════════════════════════════════════════════════════════════════════
jobs:
  pack-repo:
    runs-on: ubuntu-latest

    steps:
      # 1. Check out the full repository so Repomix can see every file.
      - name: Checkout code
        uses: actions/checkout@v4

      # 2. Derive the output filename from the chosen style so the artifact
      #    carries the correct file extension automatically.
      - name: Resolve output filename
        id: resolve
        run: |
          style="${{ inputs.style }}"
          case "$style" in
            markdown) ext="md" ;;
            json)     ext="json" ;;
            plain)    ext="txt" ;;
            *)        ext="xml" ;;
          esac
          echo "filename=repomix-output.${ext}" >> "$GITHUB_OUTPUT"

      # 3. Run Repomix with the user-supplied options.
      - name: Pack repository with Repomix
        uses: yamadashy/repomix/.github/actions/repomix@main
        with:
          directories: ${{ inputs.directories }}
          style:       ${{ inputs.style }}
          include:     ${{ inputs.include }}
          ignore:      ${{ inputs.ignore }}
          compress:    ${{ inputs.compress }}
          output:      ${{ steps.resolve.outputs.filename }}

      # 4. Upload the packed file as a workflow artifact so it can be
      #    downloaded directly from the Actions run summary page.
      - name: Upload Repomix output
        uses: actions/upload-artifact@v4
        with:
          name: ${{ steps.resolve.outputs.filename }}
          path: ${{ steps.resolve.outputs.filename }}
          retention-days: 30
</file>

<file path=".github/workflows/update-public-fabric-pages.yml">
name: update-public-fabric-pages

# ──────────────────────────────────────────────────────────────────────────────
# TRIGGERS
# ──────────────────────────────────────────────────────────────────────────────
on:
  # 1. Daily schedule — keeps the repos snapshot fresh even when no one pushes.
  schedule:
    - cron: "0 6 * * *"

  # 2. Manual trigger — run on demand from the Actions UI.
  workflow_dispatch:

  # 3. Push to main that touches the public-fabric directory — ensures human-
  #    authored edits (styles, app.js, site.json, …) are deployed immediately.
  #    Commits pushed by GITHUB_TOKEN do not fire new workflow runs, so the
  #    schedule and workflow_dispatch above cover the automated-refresh case.
  push:
    branches: ["main"]
    paths:
      - "an-overview/public-fabric/**"

# ──────────────────────────────────────────────────────────────────────────────
# PERMISSIONS
# ──────────────────────────────────────────────────────────────────────────────
permissions:
  contents: write   # Commit the refreshed repos-snapshot.json back to the repo.
  pages: write      # Upload and deploy the public-fabric site to GitHub Pages.
  id-token: write   # Required by actions/deploy-pages for OIDC-based deployment.

# ══════════════════════════════════════════════════════════════════════════════
# JOBS
# ══════════════════════════════════════════════════════════════════════════════
jobs:
  refresh-and-deploy:
    runs-on: ubuntu-latest

    # Only one Pages deployment at a time across the entire repository.
    concurrency:
      group: "pages"
      cancel-in-progress: false

    # Surface the deployed URL in the workflow run UI.
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      # 1. Check out the repository on the main branch so we can both read
      #    and write files (the git push step needs a writable working tree).
      - name: Checkout
        uses: actions/checkout@v6
        with:
          ref: main

      # 2. Refresh the repos snapshot from the GitHub API.
      #    The script writes an-overview/public-fabric/data/repos-snapshot.json.
      - name: Refresh repos snapshot
        run: python3 an-overview/script/refresh-public-fabric-snapshot.py

      # 3. Commit the updated snapshot if anything changed.
      #    Commits pushed via GITHUB_TOKEN do not fire new workflow runs, so
      #    the Pages deployment in this same run picks up the fresh snapshot.
      - name: Commit snapshot changes
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add an-overview/public-fabric/data/repos-snapshot.json
          if git diff --staged --quiet; then
            echo "Snapshot unchanged — nothing to commit."
          else
            git commit -m "chore: refresh public-fabric repos snapshot"
            git push
          fi

      # 4. Verify the public-fabric directory is present before attempting to
      #    deploy. Emit a clear warning (rather than a cryptic failure) when
      #    the directory is missing.
      - name: Check public-fabric exists
        id: check-folder
        run: |
          if [ -d "an-overview/public-fabric" ]; then
            echo "folder_exists=true" >> "$GITHUB_OUTPUT"
            echo "✅ public-fabric directory found."
          else
            echo "folder_exists=false" >> "$GITHUB_OUTPUT"
            echo "::warning::Directory an-overview/public-fabric not found. Skipping Pages deployment."
          fi

      # 5. AUTO-ENABLE Pages if it is not already active.
      - name: Enable Pages
        if: steps.check-folder.outputs.folder_exists == 'true'
        id: enable-pages
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          if gh api "repos/${{ github.repository }}/pages" --silent 2>/dev/null; then
            echo "pages_active=true" >> "$GITHUB_OUTPUT"
            echo "✅ GitHub Pages is already enabled."
          elif gh api "repos/${{ github.repository }}/pages" \
            -X POST -f build_type=workflow --silent 2>/dev/null; then
            echo "pages_active=true" >> "$GITHUB_OUTPUT"
            echo "✅ GitHub Pages has been enabled."
          else
            echo "pages_active=false" >> "$GITHUB_OUTPUT"
            echo "::warning::Could not enable GitHub Pages automatically. Please enable it manually in repository Settings → Pages → Source → GitHub Actions."
          fi

      # 6. Configure Pages metadata.
      - name: Setup Pages
        if: steps.check-folder.outputs.folder_exists == 'true' && steps.enable-pages.outputs.pages_active == 'true'
        uses: actions/configure-pages@v5

      # 7. Upload the public-fabric directory as a Pages artifact.
      - name: Upload artifact
        if: steps.check-folder.outputs.folder_exists == 'true' && steps.enable-pages.outputs.pages_active == 'true'
        uses: actions/upload-pages-artifact@v4
        with:
          path: "an-overview/public-fabric"

      # 8. Deploy the uploaded artifact to GitHub Pages.
      - name: Deploy to GitHub Pages
        if: steps.check-folder.outputs.folder_exists == 'true' && steps.enable-pages.outputs.pages_active == 'true'
        id: deployment
        uses: actions/deploy-pages@v4
</file>

